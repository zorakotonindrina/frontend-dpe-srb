        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n%% =========================\n%% EXERCICE\n%% =========================\n\nEXERCICE_PERIODE {\n    varchar periode PK\n    date date_periode\n    varchar utilisateur_saisie\n    numeric rang\n}\n\nEXERCICE_PERIODE_SAISIE {\n    uuid id_periode_saisie\n    date date_debut\n    date date_fin\n    numeric rang\n    varchar ministere_code FK\n    varchar soa_depositaire\n}\n\n%% =========================\n%% REFERENTIEL\n%% =========================\n\nREFERENTIEL_CARROSSERIE_VEHICULE {\n    uuid carrosserie_id\n    varchar carrosserie_code\n    varchar carrosserie_libelle\n}\n\nREFERENTIEL_CATEGORIE_UTILISATION_VEHICULE {\n    varchar categorie_utilisation\n    varchar categorie_utilisation_libelle\n}\n\nREFERENTIEL_CATEGORIE_VEHICULE {\n    varchar categorie_code\n    varchar categorie_libelle\n}\n\nREFERENTIEL_COMMUNE {\n    uuid commune_id PK\n    text commune_nom\n    uuid region_id FK\n}\n\nREFERENTIEL_ENERGIE_VEHICULE {\n    varchar energie_code\n    varchar energie_libelle\n}\n\nREFERENTIEL_ETAT_VEHICULE {\n    varchar etat_vehicule\n    varchar etat_libelle\n}\n\nREFERENTIEL_FOKOTANY {\n    uuid fokotany_id PK\n    text fokotany_nom\n    uuid commune_id FK\n}\n\nREFERENTIEL_FUSION_MINISTERE {\n    varchar min_code\n    varchar min_libelle\n    varchar nouv_min_code\n    varchar ministere_sigle\n}\n\nREFERENTIEL_GENRE_VEHICULE {\n    uuid genre_id\n    varchar genre_code\n    varchar genre_libelle\n}\n\nREFERENTIEL_MARQUE_VEHICULE {\n    uuid marque_id\n    varchar marque_code\n    varchar marque_libelle\n}\n\nREFERENTIEL_MINISTERE {\n    varchar min_code PK\n    text min_libelle\n}\n\nREFERENTIEL_MINISTERE_COMPLET {\n    int ministere_id_ministere\n    varchar ministere_abreviation\n    varchar ministere_code\n    varchar ministere_libelle\n    int ministere_status\n}\n\nREFERENTIEL_PROVINCE {\n    varchar province_code PK\n    varchar province_nom\n}\n\nREFERENTIEL_REGION {\n    uuid region_id PK\n    text region_nom\n}\n\nREFERENTIEL_REGIONS {\n    varchar reg_code\n    varchar fiv_code\n    varchar reg_libelle\n    varchar province_code FK\n}\n\nREFERENTIEL_SOA {\n    varchar soa_code\n    varchar soa_libelle\n    varchar commune_code\n    varchar commune_libelle\n    varchar budget_code\n}\n\n%% =========================\n%% SIIGPE - LOGEMENT\n%% =========================\n\nSIIGPE_ACCESSIBILITE {\n    uuid accessibilite_id PK\n    uuid entite_logement_id FK\n    date accessibilite_date_saisie\n    uuid accessibilite_position_par_rapport_route_principal FK\n    uuid accessibilite_emplacement FK\n    uuid accessibilite_quartier FK\n    uuid accessibilite_distance_par_rapport_a_lieu_travail FK\n}\n\nSIIGPE_ACCESSIBILITE_POSITION {\n    uuid accessibilite_position_id PK\n    text accessibilite_position_nom\n}\n\nSIIGPE_ANNE_DE_CONSTRUCTION {\n    uuid anne_de_construction_id PK\n    numeric anne_de_construction_debut\n    numeric anne_de_construction_fin\n}\n\nSIIGPE_CATEGORIE_LOGEMENT {\n    uuid categorie_logement_id PK\n    text categorie_logement_nom\n    varchar entite_id\n}\n\nSIIGPE_CATEGORIE_LOGEMENT_USAGE {\n    uuid categorie_logement_usage_id\n    uuid categorie_logement_id FK\n    uuid usage_logement_id FK\n}\n\nSIIGPE_DEPENDANCE_LOGEMENT {\n    uuid dependance_logement_id PK\n    uuid entite_logement_id FK\n    text dependance_logement_nom\n    uuid entretient_modif_log_id FK\n    uuid dependance_type_utilisation_id FK\n}\n\nSIIGPE_DEPENDANCE_TYPE_UTILISATION {\n    uuid dependance_type_utilisation_id PK\n    text dependance_type_utilisation_nom\n}\n\nSIIGPE_DISTANCE_PAR_RAP_LIEU_TRAVAIL {\n    uuid distance_par_rap_lieu_travail_id PK\n    text distance_par_rap_lieu_travail_debut\n    text distance_par_rap_lieu_travail_fin\n}\n\nSIIGPE_EMPLACEMENT {\n    uuid emplacement_id PK\n    text emplacement_nom\n}\n\nSIIGPE_ENTITE {\n    uuid entite_id PK\n    text entite_nom\n    uuid entite_parent_id FK\n    varchar entite_diminutif\n}\n\nSIIGPE_ENTITE_LOGEMENT {\n    uuid entite_logement_id PK\n    varchar min_code FK\n    uuid type_logement_id FK\n    uuid categorie_logement_id FK\n    uuid localisation_id FK\n    uuid fokotany_id FK\n    uuid entite_id FK\n    uuid info_tech_log_gen_id FK\n    text reference_acte FK\n    uuid etat_logement_id FK\n    uuid statut_logement_id FK\n    uuid info_occupant_id FK\n    text entite_logement_adresse\n}\n\nSIIGPE_ENTITE_LOGEMENT_USAGE {\n    uuid entite_logement_usage_id\n    uuid usage_logement_id FK\n    uuid entite_logement_id FK\n}\n\nSIIGPE_ENTRETIENT_MODIFICATION_LOGEMENT_TYPE {\n    uuid entretient_et_modification_logement_type_id PK\n    text entretient_et_modification_logement_type_nom\n}\n\nSIIGPE_ENTRETIENT_MODIFICATION_LOGEMENT {\n    uuid entretient_modif_log_id PK\n    uuid entite_logement_id FK\n    uuid entretient_modif_log_type FK\n    text entretient_modif_log_intitule\n    date entretient_modif_log_date\n}\n\nSIIGPE_ETAT_LOGEMENT {\n    uuid etat_logement_id PK\n    text etat_logement_nom\n    varchar etat_logement_diminutif\n}\n\nSIIGPE_FONCTION {\n    uuid fonction_code\n    text fonction_libelle\n}\n\nSIIGPE_HISTORIQUE_BATIMENT {\n    uuid i_trace_update_id PK\n    varchar i_tr_uptade_utilisateur_id\n    timestamp i_tr_update_date_update\n    varchar i_tr_update_nom_table\n    varchar reference_acte FK\n}\n\nSIIGPE_INFORMATION_CONJOINT {\n    uuid information_conjoint_id PK\n    text information_conjoint_nom\n    text information_conjoint_prenoms\n    varchar information_conjoint_cin\n    varchar information_conjoint_min_code FK\n}\n\nSIIGPE_INFORMATION_FONCIERE_CADASTRE {\n    uuid info_fonc_cadastre_id PK\n    text info_fonc_cadastre_nom_proprietaire\n    text info_fonc_cadastre_num_parcelle\n}\n\nSIIGPE_INFORMATION_FONCIERE_TITRE {\n    uuid info_fonc_titre_id PK\n    text info_fonc_titre_nom_propriete\n    text info_fonc_titre_num_titre\n}\n\nSIIGPE_INFORMATION_OCCUPANT {\n    uuid info_occupant_id PK\n    text info_occupant_nom\n    text info_occupant_prenoms\n    varchar info_occupant_cin\n    varchar info_occupant_im\n    varchar info_occupant_min_code FK\n    uuid information_conjoint_id FK\n}\n\nSIIGPE_INFORMATION_TECH_LOG_PIECE {\n    uuid information_tech_log_piece_id PK\n    uuid info_tech_log_niv_id FK\n    text information_tech_log_nom\n    float information_tech_log_piece_surface\n}\n\nSIIGPE_INFORMATION_TECH_LOGEMENT_NIVEAU {\n    uuid info_tech_log_niv_id PK\n    text info_tech_log_niv_nom\n    uuid niveau_type_id FK\n}\n\nSIIGPE_INFORMATION_TECHNIQUE_LOGEMENT {\n    uuid info_tech_log_id PK\n    uuid entite_logement_id FK\n    uuid info_tech_log_niv_id FK\n    date info_tech_log_date_saisie\n}\n\nSIIGPE_INFORMATION_TECHNIQUE_LOGEMENT_GENERAL {\n    uuid info_tech_log_gen_id PK\n    text info_tech_log_anne_de_construction\n    uuid info_tech_log_type_materiau_construction FK\n    uuid info_tech_log_type_de_toiture FK\n}\n\nSIIGPE_LOCALISATION {\n    uuid localisation_id PK\n    text localisation_ville_nom\n}\n\nSIIGPE_LOGEMENT_ET_OCCUPANT {\n    uuid logement_et_occupant_id PK\n    uuid information_tech_log_piece_id FK\n    uuid info_occupant_id FK\n    date logement_et_occupant_date_saisie\n}\n\nSIIGPE_MATIERE {\n    uuid matiere_id PK\n    text matiere_nom\n    text matiere_parent\n}\n\nSIIGPE_MATIERE_TYPE_NOMBRE {\n    uuid matiere_type_nombre_id PK\n    uuid matiere_id FK\n    uuid info_tech_log_niv_id FK\n    uuid information_tech_log_piece_id FK\n    numeric matiere_nombre\n}\n\nSIIGPE_NIVEAU_TYPE {\n    uuid niveau_type_id PK\n    text niveau_type_nom\n}\n\nSIIGPE_QUARTIER {\n    uuid quartier_id PK\n    text quartier_nom\n}\n\nSIIGPE_STATUT_LOGEMENT {\n    uuid statut_logement_id\n    text statut_logement_libelle\n}\n\nSIIGPE_TYPE_LOGEMENT {\n    uuid type_logement_id PK\n    text type_logement_nom\n}\n\nSIIGPE_TYPE_OCCUPANT_REEL {\n    uuid type_occupant_reel_id PK\n    text type_occupant_reel_nom\n}\n\nSIIGPE_USAGE_LOGEMENT {\n    uuid usage_logement_id\n    text usage_logement_libelle\n}\n\nSIIGPE_VIABILISATION_TYPE_ELEC {\n    uuid viabilisation_type_elec_id PK\n    text viabilisation_type_elec_nom\n    text viabilisation_type\n}\n\nSIIGPE_VIABLISATION {\n    uuid viablisation_id PK\n    uuid entite_logement_id FK\n    uuid viablisation_source_energie_elec FK\n    uuid viablisation_acces_en_eau FK\n    uuid entretient_modif_log_id FK\n    date viablisation_date_saisie\n}\n\n%% =========================\n%% SIIGPE - VEHICULE\n%% =========================\n\nSIIGPE_ENTITE_VEHICULE {\n    uuid vehicule_id PK\n    uuid entite_id FK\n    varchar vehicule_immatriculation\n    varchar min_code FK\n    varchar serie_id\n    varchar vehicule_genre FK\n    varchar vehicule_source_energie FK\n    varchar categorie_vehicule FK\n    varchar etat_vehicule FK\n    uuid vehicule_marque_id FK\n    varchar reference_acte FK\n    varchar exercice FK\n    varchar soa_depositaire\n}\n\nSIIGPE_ENTITE_UTILISATION_VEHICULE {\n    uuid entite_utilisation_vehicule_id\n    uuid information_utilisation_id FK\n    varchar soa_code FK\n    varchar min_code FK\n}\n\nSIIGPE_ENTRETIEN_REPARATION_VEHICULE {\n    varchar entretien_reparation_vehicule_id PK\n    uuid vehicule_id FK\n    uuid fournisseur\n    varchar reference_acte FK\n    date date_saisie\n}\n\nSIIGPE_HISTORIQUE_VEHICULE {\n    uuid vehicule_id\n    varchar vehicule_immatriculation\n    varchar min_code FK\n    varchar reference_acte FK\n    varchar exercice FK\n    varchar historique_type\n    date historique_date\n}\n\nSIIGPE_IMMATRICULATION_AGENT {\n    varchar matricule\n    varchar nom\n    varchar prenom\n    varchar cin\n    varchar fiv_code\n}\n\nSIIGPE_INFORMATION_UTILISATION_VEHICULE {\n    uuid information_utilisation_id PK\n    varchar categorie_utilisation FK\n    uuid vehicule_id FK\n    varchar reg_code FK\n    varchar province_code FK\n    varchar reference_acte FK\n}\n\nSIIGPE_QUITUS_VEHICULE {\n    varchar reference_quitus\n    uuid id_vehicule FK\n    date date_quitus\n    varchar periode FK\n}\n\nSIIGPE_REPARATION_EFFECTUE_VEHICULE {\n    uuid reparation_effectue_id PK\n    uuid entretien_reparation_vehicule_id FK\n    varchar reparation_effectue_detail\n}\n\nSIIGPE_SOA_COMPLET {\n    varchar soa_code\n    varchar soa_libelle\n    varchar commune_code\n    varchar commune_libelle\n    varchar budget_code\n}\n\nSIIGPE_VEHICULE_DETENTEUR {\n    uuid detenteur_id PK\n    varchar detenteur_nom_prenom\n    numeric detenteur_cin\n    varchar reference_acte FK\n    uuid vehicule_id FK\n}\n\nSIIGPE_VEHICULE_MARQUE {\n    uuid vehicule_marque_id PK\n    varchar vehicule_marque_nom\n}\n\nSIIGPE_VEHICULE_SERIE {\n    uuid vehicule_serie_id PK\n    uuid vehicule_marque_id FK\n    varchar vehicule_serie_nom\n}\n\n%% =========================\n%% WORKFLOW\n%% =========================\n\nWORKFLOW_ACTION_QUERY {\n    varchar action PK\n    text query\n}\n\nWORKFLOW_BROUILLARD_UTILISATEUR {\n    varchar login\n    varchar matricule\n    varchar uadm_code\n    varchar email\n    varchar statut\n}\n\nWORKFLOW_BROUILLARD_UTILISATEUR_RENITIALISER {\n    varchar matricule\n    varchar password\n    date date_saisie\n    varchar statut\n    varchar cin\n}\n\nWORKFLOW_DOSSIER {\n    varchar reference_acte PK\n    date dossier_date_depot\n    varchar reference_ministere\n    varchar type_acte FK\n    varchar ministere_code FK\n    varchar processus_code FK\n    varchar type_groupe_code FK\n}\n\nWORKFLOW_PRIVILEGE {\n    varchar code_privilege PK\n    varchar libelle_privilege\n    numeric statut\n}\n\nWORKFLOW_PRIVILEGE_ROLE {\n    varchar code_privilege FK\n    varchar role_code FK\n}\n\nWORKFLOW_REFERENTIEL_ETAT {\n    varchar etat_code\n    varchar etat_libelle\n    varchar jasper\n    varchar etat_type\n}\n\nWORKFLOW_TENTATIVE_CONNEXION {\n    uuid code_tentative PK\n    varchar utilisateur_matricule FK\n    varchar login\n    varchar cin\n    int nombre_connexion\n}\n\nWORKFLOW_TRACE_SESSION {\n    uuid reference_securite PK\n    text login\n    varchar utilisateur_matricule FK\n    date date_intervention\n}\n\nWORKFLOW_TYPE_ACTE {\n    varchar type_code PK\n    text type_libelle\n    varchar type_groupe_code FK\n    varchar sanction_code\n    varchar processus_code FK\n}\n\nWORKFLOW_TYPE_ACTE_GROUPE {\n    varchar type_groupe_code PK\n    text type_groupe_libelle\n}\n\nWORKFLOW_UTILISATEUR {\n    varchar utilisateur_matricule PK\n    varchar utilisateur_type\n    varchar utilisateur_nom\n    varchar utilisateur_prenom\n    varchar login\n    varchar email\n    varchar cin\n}\n\nWORKFLOW_UTILISATEUR_HISTORIQUE {\n    uuid id_historique PK\n    varchar utilisateur_matricule FK\n    varchar cin\n    varchar type_action\n    date date_historique\n}\n\nWORKFLOW_UTILISATEUR_IMAGES {\n    varchar agent_cin PK\n    varchar agent_matricule FK\n    text agent_image\n}\n\nWORKFLOW_UTILISATEUR_ROLE {\n    varchar utilisateur_matricule FK\n    varchar role_code FK\n    varchar uadm_code\n}\n\nWORKFLOW_WF_ACTIVITE {\n    varchar activite_code\n    varchar activite_libelle\n    varchar processus_code FK\n    varchar activite_avant\n    varchar activite_suivant\n    varchar entite_code\n}\n\nWORKFLOW_WF_PROCESSUS {\n    varchar processus_code\n    varchar processus_libelle\n    varchar processus_etat\n}\n\nWORKFLOW_WF_PROCESSUS_ACTIVITE_TACHE {\n    varchar processus_code FK\n    varchar activite_code FK\n    varchar tache_a_faire\n    text reference_acte FK\n    varchar detenteur\n}\n\nWORKFLOW_WF_ROLE {\n    varchar role_code PK\n    varchar role_libelle\n    varchar role_entite\n}\n\nWORKFLOW_WF_SOUS_ENTITE {\n    varchar sous_entite_code\n    varchar entite_code\n    varchar sous_entite_libelle\n}\n\nWORKFLOW_WF_TACHE_ROLE_ENTITE {\n    varchar tache_code\n    varchar tache_libelle\n    varchar activite_code FK\n    varchar role_code FK\n    varchar sous_entite_code FK\n}\n\n%% =========================\n%% RELATIONS REFERENTIEL\n%% =========================\n\nREFERENTIEL_REGION ||--o{ REFERENTIEL_COMMUNE : contient\nR